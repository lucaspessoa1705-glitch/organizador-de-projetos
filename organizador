// ===================================
// CONFIGURAÇÃO E ARMAZENAMENTO
// ===================================

const STORAGE_KEY = "organizador_projetos_v1";

function obterProjetosDoDom() {
    const itens = [];
    const secoes = document.querySelectorAll("main > section.category-section");

    secoes.forEach((secao) => {
        const tituloEl = secao.querySelector(".category-title");
        const cards = secao.querySelectorAll(".grid .card");
        if (!tituloEl || cards.length === 0) return;

        const categoria = tituloEl.textContent.trim();

        cards.forEach((card, idx) => {
            const numeroEl = card.querySelector(".number");
            const id = numeroEl ? numeroEl.textContent.trim() : String(idx + 1);
            const nome = card.textContent.replace(id, "").trim();

            itens.push({
                id,
                nome,
                categoria,
                progresso: 0
            });
        });
    });

    return itens;
}

function carregarEstado() {
    const base = obterProjetosDoDom();
    const salvo = localStorage.getItem(STORAGE_KEY);
    if (!salvo) return base;

    try {
        const dadosSalvos = JSON.parse(salvo);
        return base.map((item) => {
            const match = dadosSalvos.find((d) => d.id === item.id);
            const progresso = match ? Number(match.progresso) : 0;
            return {
                ...item,
                progresso: Number.isFinite(progresso) ? progresso : 0
            };
        });
    } catch {
        return base;
    }
}

function salvarEstado(projetos) {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(projetos));
}

// ===================================
// REGRAS DE STATUS E TROFÉUS
// ===================================

function obterStatusInfo(progresso) {
    if (progresso >= 100) {
        return { texto: "Concluído", classe: "concluido" };
    }
    if (progresso > 0) {
        return { texto: "Em andamento", classe: "andamento" };
    }
    return { texto: "Não iniciado", classe: "nao-iniciado" };
}

function atualizarEstatisticas(projetos) {
    const total = projetos.length;
    const emAndamento = projetos.filter((p) => p.progresso > 0 && p.progresso < 100).length;
    const concluidos = projetos.filter((p) => p.progresso >= 100).length;
    const soma = projetos.reduce((acc, p) => acc + (Number(p.progresso) || 0), 0);
    const mediaGeral = total > 0 ? Math.round(soma / total) : 0;

    const totalEl = document.getElementById("totalProjetos");
    const andamentoEl = document.getElementById("emAndamento");
    const concluidosEl = document.getElementById("concluidos");
    const mediaEl = document.getElementById("mediaGeral");

    if (totalEl) totalEl.textContent = total;
    if (andamentoEl) andamentoEl.textContent = emAndamento;
    if (concluidosEl) concluidosEl.textContent = concluidos;
    if (mediaEl) mediaEl.textContent = `${mediaGeral}%`;

    return { total, concluidos, mediaGeral };
}

function atualizarTrofeus(total, concluidos, mediaGeral) {
    const linhasTrofeu = document.querySelectorAll("#tabelaTrofeus tr");

    linhasTrofeu.forEach((linha) => {
        const metaConcluidos = Number(linha.dataset.meta);
        const nivel = linha.dataset.nivel;
        const celulaStatus = linha.querySelector(".trophy-status");

        // Desbloqueia se atingir a quantidade de concluídos OU se a média geral passar de certas porcentagens (Ex: Prata >= 30% ou 10 concluídos; Ouro = 100%)
        let desbloqueado = false;
        if (nivel === "bronze") {
            desbloqueado = concluidos >= 1 || mediaGeral > 0;
        } else if (nivel === "prata") {
            desbloqueado = concluidos >= metaConcluidos || mediaGeral >= 30;
        } else if (nivel === "ouro") {
            desbloqueado = concluidos >= total || mediaGeral >= 100;
        }

        linha.classList.toggle("unlocked", desbloqueado);
        linha.classList.toggle("final-trophy", desbloqueado && nivel === "ouro");

        if (celulaStatus) {
            if (!desbloqueado) {
                celulaStatus.textContent = "Bloqueado";
            } else if (nivel === "bronze") {
                celulaStatus.textContent = "Medalha e Troféu de Bronze Conquistados!";
            } else if (nivel === "prata") {
                celulaStatus.textContent = "Medalha e Troféu de Prata Conquistados!";
            } else if (nivel === "ouro") {
                celulaStatus.textContent = "Medalha e Troféu de Ouro Conquistados!";
            }
        }
    });

    const badgeEl = document.getElementById("trofeuAtual");
    const nivelTextoEl = document.getElementById("nivelAtualTexto");
    const proximoTextoEl = document.getElementById("proximoMarcoTexto");

    if (!badgeEl || !nivelTextoEl || !proximoTextoEl) return;

    if (concluidos >= total || mediaGeral >= 100) {
        badgeEl.textContent = "🥇";
        nivelTextoEl.textContent = "Última Evolução: Medalha e Troféu de Ouro";
        proximoTextoEl.textContent = `Incrível! Você atingiu 100% ou concluiu todos os ${total} projetos.`;
    } else if (concluidos >= 10 || mediaGeral >= 30) {
        badgeEl.textContent = "🥈";
        nivelTextoEl.textContent = "2ª Evolução: Medalha e Troféu de Prata";
        proximoTextoEl.textContent = `Progresso geral em ${mediaGeral}%. Continue para alcançar o Ouro!`;
    } else if (concluidos >= 1 || mediaGeral > 0) {
        badgeEl.textContent = "🥉";
        nivelTextoEl.textContent = "1ª Evolução: Medalha e Troféu de Bronze";
        proximoTextoEl.textContent = `Média atual: ${mediaGeral}%. Alcance 30% ou 10 projetos para a Prata.`;
    } else {
        badgeEl.textContent = "🥉";
        nivelTextoEl.textContent = "Nível Atual: Nenhuma Conquista Ainda";
        proximoTextoEl.textContent = "Atualize o progresso dos projetos para desbloquear as conquistas.";
    }
}

function atualizarResumoETrofeus(projetos) {
    const { total, concluidos, mediaGeral } = atualizarEstatisticas(projetos);
    atualizarTrofeus(total, concluidos, mediaGeral);
}

// ===================================
// RENDERIZAÇÃO DA TABELA PRINCIPAL
// ===================================

function renderizarTabela(projetos) {
    const tbody = document.getElementById("tabelaProjetos");
    if (!tbody) return;

    tbody.innerHTML = "";

    projetos.forEach((projeto) => {
        const status = obterStatusInfo(projeto.progresso);
        const tr = document.createElement("tr");

        tr.innerHTML = `
            <td><strong>#${projeto.id}</strong> ${projeto.nome}</td>
            <td>${projeto.categoria}</td>
            <td><span class="status ${status.classe}">${status.texto}</span></td>
            <td>
                <progress class="progress-bar" max="100" value="${projeto.progresso}"></progress>
                <span class="progress-value">${projeto.progresso}%</span>
            </td>
            <td>
                <select class="atualizar-progresso" aria-label="Atualizar progresso de ${projeto.nome}">
                    <option value="0" ${projeto.progresso === 0 ? "selected" : ""}>0%</option>
                    <option value="25" ${projeto.progresso === 25 ? "selected" : ""}>25%</option>
                    <option value="50" ${projeto.progresso === 50 ? "selected" : ""}>50%</option>
                    <option value="75" ${projeto.progresso === 75 ? "selected" : ""}>75%</option>
                    <option value="100" ${projeto.progresso === 100 ? "selected" : ""}>100%</option>
                </select>
            </td>
        `;

        const select = tr.querySelector("select");
        select.addEventListener("change", (e) => {
            projeto.progresso = Number(e.target.value);
            salvarEstado(projetos);
            renderizarTabela(projetos);
            atualizarResumoETrofeus(projetos);
        });

        tbody.appendChild(tr);
    });
}

// ===================================
// INICIALIZAÇÃO
// ===================================

document.addEventListener("DOMContentLoaded", () => {
    const projetos = carregarEstado();
    renderizarTabela(projetos);
    atualizarResumoETrofeus(projetos);
});
/* ===== DEFINIÇÕES GERAIS E CORES FUTURISTAS ===== */
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    background-color: #0b0f19;
    color: #ffffff;
    font-family: 'Outfit', sans-serif;
    padding: 20px;
}

/* ===== CABEÇALHO ===== */
.hero {
    text-align: center;
    padding: 40px 20px;
    margin-bottom: 30px;
    border-bottom: 2px solid rgba(0, 243, 255, 0.2);
}

.hero h1 {
    font-size: 2.8rem;
    font-weight: 800;
    background: linear-gradient(90deg, #00f3ff, #b537f2);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    letter-spacing: 2px;
    margin-bottom: 10px;
}

.hero p {
    font-family: 'Fira Code', monospace;
    font-size: 0.95rem;
    color: #8b9bb4;
    letter-spacing: 1px;
}

/* ===== CATEGORIAS E GRADE ===== */
.category-section {
    max-width: 1060px;
    margin: 0 auto 38px;
}

.category-title {
    color: #00e5e9;
    font-size: 19px;
    font-weight: 700;
    border-left: 4px solid #00e5e9;
    padding: 3px 12px;
    margin-bottom: 14px;
}

.category-section .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
}

/* ===== CARTÕES E LINKS DE PROJETOS ===== */
.card {
    background-color: #131b2e;
    border: 1px solid rgba(255, 255, 255, 0.08);
    padding: 15px 20px;
    min-height: 54px;
    border-radius: 9px;
    display: flex;
    align-items: center;
    color: #ffffff;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: all 0.25s ease;
    cursor: pointer;
}

.card:hover {
    background-color: #17223b;
    border-color: #00f3ff;
    box-shadow: 0 5px 18px rgba(0, 243, 255, 0.15);
    transform: translateY(-3px);
}

.card:active {
    transform: scale(0.98);
}

.number {
    font-family: 'Fira Code', monospace;
    background-color: rgba(0, 243, 255, 0.1);
    color: #00f3ff;
    padding: 4px 8px;
    border-radius: 4px;
    font-size: 0.85rem;
    margin-right: 15px;
    font-weight: bold;
}

/* ===== PAINEL DE MEDALHAS E TROFÉUS (TAMANHO NORMAL) ===== */
.trophy-panel {
    max-width: 1060px;
    margin: 0 auto 38px;
}

.trophy-current {
    display: flex;
    align-items: center;
    gap: 15px;
    background: linear-gradient(90deg, rgba(0, 243, 255, 0.08), rgba(181, 55, 242, 0.08));
    border: 1px solid rgba(0, 243, 255, 0.25);
    border-radius: 14px;
    padding: 16px 20px;
    margin-bottom: 16px;
}

.trophy-badge {
    font-size: 2rem;
    line-height: 1;
}

.trophy-current strong {
    display: block;
    font-size: 1rem;
    color: #ffffff;
    margin-bottom: 4px;
}

.trophy-current p {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: 0;
}

.mini-table-container {
    margin-top: 0;
}

.trophy-table {
    min-width: 650px;
}

.trophy-table tr.unlocked td:last-child {
    color: #4ade80;
    font-weight: 600;
}

.trophy-table tr.unlocked.final-trophy {
    background: rgba(250, 204, 21, 0.12);
    box-shadow: inset 3px 0 0 #facc15;
}

.trophy-table tr.unlocked.final-trophy td:last-child {
    color: #facc15;
}

/* ===== CARDS DE RESUMO ===== */
.evolution-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-top: 20px;
}

.evolution-card {
    background: #171b2e;
    border: 1px solid #30364d;
    border-radius: 15px;
    padding: 22px;
    text-align: center;
    transition: transform 0.3s ease, border-color 0.3s ease;
}

.evolution-card:hover {
    transform: translateY(-5px);
    border-color: #38bdf8;
}

.evolution-card h3 {
    color: #38bdf8;
    font-size: 28px;
    margin: 0 0 8px;
}

.evolution-card p {
    color: #94a3b8;
    font-size: 14px;
    margin: 0;
}

/* ===== TABELA DE EVOLUÇÃO DOS PROJETOS ===== */
.table-container {
    width: 100%;
    overflow-x: auto;
    margin-top: 25px;
    border-radius: 15px;
    border: 1px solid #30364d;
    background: #171b2e;
}

.progress-table {
    width: 100%;
    min-width: 750px;
    border-collapse: collapse;
    color: #ffffff;
    font-family: 'Outfit', sans-serif;
}

.progress-table thead {
    background: #252c45;
}

.progress-table th {
    padding: 18px 15px;
    text-align: left;
    color: #38bdf8;
    font-size: 13px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.progress-table td {
    padding: 16px 15px;
    border-bottom: 1px solid #30364d;
    font-size: 14px;
}

.progress-table tbody tr {
    transition: background 0.3s ease;
}

.progress-table tbody tr:hover {
    background: #252c45;
}

.progress-table tbody tr:last-child td {
    border-bottom: none;
}

/* Status */
.progress-table .status {
    font-weight: 600;
    color: #facc15;
}

.progress-table .status.concluido {
    color: #4ade80;
}

.progress-table .status.andamento {
    color: #38bdf8;
}

.progress-table .status.nao-iniciado {
    color: #94a3b8;
}

/* Barra de progresso */
.progress-bar {
    width: 110px;
    height: 10px;
    accent-color: #22c55e;
    vertical-align: middle;
}

.progress-value {
    margin-left: 8px;
    color: #38bdf8;
    font-weight: 600;
}

/* Seleção de progresso */
.progress-table select {
    background: #252c45;
    color: #ffffff;
    border: 1px solid #475569;
    border-radius: 8px;
    padding: 9px 12px;
    outline: none;
    cursor: pointer;
    transition: border 0.3s ease;
}

.progress-table select:hover,
.progress-table select:focus {
    border-color: #38bdf8;
}

/* ===== RODAPÉ ===== */
footer {
    text-align: center;
    padding: 30px;
    color: #5d6d85;
    font-size: 0.85rem;
    border-top: 1px solid rgba(255, 255, 255, 0.05);
    margin-top: 50px;
}

/* ===== RESPONSIVIDADE ===== */
@media (max-width: 768px) {
    .category-section .grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .evolution-cards {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .table-container {
        border-radius: 10px;
    }

    .progress-table th,
    .progress-table td {
        padding: 12px;
        font-size: 12px;
    }

    .progress-bar {
        width: 75px;
    }
}

@media (max-width: 480px) {
    .category-section .grid {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 2rem;
    }
}
